{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://whatsapp-reminder-0yad.onrender.com/api/$1"
    },
    {
      "src": "/download/apk",
      "status": 302,
      "headers": {
        "Location": "/ReminderMe.apk"
      }
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
