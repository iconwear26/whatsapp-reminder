{
  "version": 2,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://whatsapp-reminder-0yad.onrender.com/api/$1"
    },
    {
      "src": "/download/apk",
      "headers": {
        "Content-Disposition": "attachment; filename=\"ReminderMe.apk\"",
        "Content-Type": "application/vnd.android.package-archive"
      },
      "dest": "/ReminderMe.apk"
    },
    {
      "src": "/ReminderMe.apk",
      "headers": {
        "Content-Disposition": "attachment; filename=\"ReminderMe.apk\"",
        "Content-Type": "application/vnd.android.package-archive"
      },
      "dest": "/ReminderMe.apk"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
