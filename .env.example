# ==============================================================================
# REMINDER ME - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace all placeholder values with your real credentials.
# NEVER commit the actual .env file to Git!
# ==============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=production

# Security & Authentication (Server-Side Only)
# Generate a strong 64-character secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_signing_secret_here_min_32_characters

# Owner & Super-Admin Credentials
OWNER_EMAIL=owner@example.com
OWNER_ALT_EMAIL=admin@example.com
OWNER_PHONE=918529062363
OWNER_INITIAL_PASSWORD=your_secure_initial_owner_password

# Payment Gateway (Razorpay)
# RAZORPAY_KEY_SECRET MUST NEVER BE EXPOSED CLIENT-SIDE
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Web Push Notifications (VAPID Keys)
# Generate new pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here_keep_secret
VAPID_EMAIL=mailto:support@yourdomain.com

# Database / Storage Configuration (Optional)
DATA_DIR=./data
DATABASE_URL=
